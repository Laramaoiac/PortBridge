+fn glGetUniformfv(env: &mut Environment, program: GLuint, location: GLint, params: MutPtr<GLfloat>) {
+    with_ctx2(env, "glGetUniformfv", |mem| {
+        let mut v = [0.0 as GLfloat; 16];
+        unsafe { gl::GetUniformfv(program, location, v.as_mut_ptr()) };
+        // The size depends on the uniform's type; mat4 is the largest.
+        let n = uniform_size(program, location);
+        for (i, x) in v.iter().take(n).enumerate() {
+            mem.write(params + i as GuestUSize, *x);
+        }
+    })
+}
+fn glGetUniformiv(env: &mut Environment, program: GLuint, location: GLint, params: MutPtr<GLint>) {
+    with_ctx2(env, "glGetUniformiv", |mem| {
+        let mut v = [0 as GLint; 16];
+        unsafe { gl::GetUniformiv(program, location, v.as_mut_ptr()) };
+        let n = uniform_size(program, location);
+        for (i, x) in v.iter().take(n).enumerate() {
+            mem.write(params + i as GuestUSize, *x);
+        }
+    })
+}
+/// Number of components of the uniform at `location` (1 if unknown).
+fn uniform_size(program: GLuint, location: GLint) -> usize {
+    unsafe {
+        let mut n: GLint = 0;
+        gl::GetProgramiv(program, gl::ACTIVE_UNIFORMS, &mut n);
+        let mut name = [0u8; 256];
+        for i in 0..n.max(0) as GLuint {
+            let (mut len, mut size, mut ty): (GLsizei, GLint, GLenum) = (0, 0, 0);
+            gl::GetActiveUniform(program, i, 256, &mut len, &mut size, &mut ty, name.as_mut_ptr() as *mut GLchar);
+            if gl::GetUniformLocation(program, name.as_ptr() as *const GLchar) == location {
+                return match ty {
+                    gl::FLOAT_VEC2 | gl::INT_VEC2 | gl::BOOL_VEC2 => 2,
+                    gl::FLOAT_VEC3 | gl::INT_VEC3 | gl::BOOL_VEC3 => 3,
+                    gl::FLOAT_VEC4 | gl::INT_VEC4 | gl::BOOL_VEC4 | gl::FLOAT_MAT2 => 4,
+                    gl::FLOAT_MAT3 => 9,
+                    gl::FLOAT_MAT4 => 16,
+                    _ => 1,
+                };
+            }
+        }
+        1
+    }
+}
