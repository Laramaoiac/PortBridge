+#[allow(clippy::too_many_arguments)]
+fn get_active(
+    env: &mut Environment,
+    which: &str,
+    program: GLuint,
+    index: GLuint,
+    bufsize: GLsizei,
+    length: MutPtr<GLsizei>,
+    size: MutPtr<GLint>,
+    type_: MutPtr<GLenum>,
+    name: MutPtr<GLchar>,
+    uniform: bool,
+) {
+    with_ctx2(env, which, |mem| {
+        let mut buf = vec![0u8; 256];
+        let (mut written, mut sz, mut ty): (GLsizei, GLint, GLenum) = (0, 0, 0);
+        unsafe {
+            let f = if uniform { gl::GetActiveUniform } else { gl::GetActiveAttrib };
+            f(
+                program,
+                index,
+                buf.len() as GLsizei,
+                &mut written,
+                &mut sz,
+                &mut ty,
+                buf.as_mut_ptr() as *mut GLchar,
+            );
+        }
+        buf.truncate(written.max(0) as usize);
+        if !size.is_null() {
+            mem.write(size, sz);
+        }
+        if !type_.is_null() {
+            mem.write(type_, ty);
+        }
+        write_guest_string(mem, &buf, bufsize, length, name);
+    })
+}
