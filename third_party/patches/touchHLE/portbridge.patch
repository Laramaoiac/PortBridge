diff --git a/src/gles/gles2.rs b/src/gles/gles2.rs
new file mode 100644
index 00000000..a40f24b2
--- /dev/null
+++ b/src/gles/gles2.rs
@@ -0,0 +1,730 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! PortBridge: OpenGL ES 2.0 for apps that create their `EAGLContext` with
+//! `kEAGLRenderingAPIOpenGLES2`.
+//!
+//! The calls are passed through to the host driver:
+//! - native OpenGL ES 2.0 (Android, or `--gles1=gles1_native` elsewhere);
+//! - desktop OpenGL (compatibility profile with `ARB_ES2_compatibility`, which
+//!   every Mesa, NVIDIA and AMD driver has), so the context can share objects
+//!   with the OpenGL 2.1 context that presents the frames.
+//!
+//! [GLES] is implemented so the code shared with OpenGL ES 1.1 (buffers,
+//! textures, framebuffers, drawing, frame presentation) works unchanged. The
+//! fixed-function parts of that trait don't exist in ES 2.0: an ES 2.0 app
+//! never calls them, so they only log. Shaders, programs, uniforms and vertex
+//! attributes are exposed by [crate::frameworks::opengles] directly through
+//! [raw], which is valid while this context is current.
+
+use super::gles11_raw as gles11; // constants only
+use super::gles11_raw::types::*;
+use super::gles_generic::GLES;
+use super::util::{try_decode_pvrtc, PalettedTextureFormat};
+use super::GLESContext;
+use crate::window::{GLContext, GLVersion, Window};
+use std::collections::HashSet;
+use std::ffi::CStr;
+use std::marker::PhantomData;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Mutex;
+
+pub use touchHLE_gl_bindings::gles20 as raw;
+use touchHLE_gl_bindings::gles20 as gles20;
+
+/// Whether the ES 2.0 calls go to desktop OpenGL (see [shader_source_prefix]).
+static DESKTOP_GL: AtomicBool = AtomicBool::new(false);
+
+/// Desktop OpenGL compiles a shader without `#version` as GLSL 1.10, which
+/// doesn't know `precision` and other GLSL ES 1.00 syntax. `#version 100`
+/// selects GLSL ES 1.00 (ARB_ES2_compatibility). Native ES 2.0 needs nothing.
+pub fn shader_source_prefix() -> Option<&'static str> {
+    if DESKTOP_GL.load(Ordering::Relaxed) {
+        Some("#version 100\n")
+    } else {
+        None
+    }
+}
+
+fn es1_only(name: &'static str) {
+    static SEEN: Mutex<Option<HashSet<&'static str>>> = Mutex::new(None);
+    let mut seen = SEEN.lock().unwrap();
+    if seen.get_or_insert_with(HashSet::new).insert(name) {
+        log!(
+            "PortBridge: gl{} (OpenGL ES 1.1 only) called on an OpenGL ES 2.0 context; ignored",
+            name
+        );
+    }
+}
+
+/// Loads the ES 2.0 entry points. Desktop OpenGL has the extension functions
+/// without the suffix (glGenVertexArrays, glMapBuffer...).
+fn load(get: &mut dyn FnMut(&str) -> *const std::ffi::c_void) {
+    gles20::load_with(|name| {
+        let p = get(name);
+        if !p.is_null() {
+            return p;
+        }
+        for suffix in ["OES", "EXT"] {
+            if let Some(base) = name.strip_suffix(suffix) {
+                let p = get(base);
+                if !p.is_null() {
+                    return p;
+                }
+            }
+        }
+        p
+    });
+}
+
+pub struct GLES2Context {
+    gl_ctx: GLContext,
+    is_loaded: bool,
+    desktop: bool,
+}
+impl GLES2Context {
+    /// OpenGL ES 2.0 calls on a desktop OpenGL compatibility context.
+    pub fn new_on_desktop_gl(window: &mut Window) -> Result<Self, String> {
+        Ok(Self {
+            gl_ctx: window.create_gl_context(GLVersion::GL21Compat)?,
+            is_loaded: false,
+            desktop: true,
+        })
+    }
+
+    fn after_load(&mut self) {
+        if self.desktop {
+            DESKTOP_GL.store(true, Ordering::Relaxed);
+            unsafe {
+                // Always on in ES 2.0: gl_PointSize and gl_PointCoord.
+                gles20::Enable(0x8642); // GL_PROGRAM_POINT_SIZE
+                gles20::Enable(0x8861); // GL_POINT_SPRITE
+                while gles20::GetError() != 0 {}
+            }
+        }
+    }
+}
+impl GLESContext for GLES2Context {
+    fn description() -> &'static str {
+        "OpenGL ES 2.0 (PortBridge)"
+    }
+
+    fn new(window: &mut Window) -> Result<Self, String> {
+        Ok(Self {
+            gl_ctx: window.create_gl_context(GLVersion::GLES20)?,
+            is_loaded: false,
+            desktop: false,
+        })
+    }
+
+    fn make_current<'gl_ctx, 'win: 'gl_ctx>(
+        &'gl_ctx mut self,
+        window: &'win mut Window,
+    ) -> Box<dyn GLES + 'gl_ctx> {
+        if !(self.gl_ctx.is_current() && self.is_loaded) {
+            unsafe {
+                window.make_gl_context_current(&self.gl_ctx);
+            }
+            if !self.is_loaded {
+                load(&mut |s| window.gl_get_proc_address(s));
+                self.is_loaded = true;
+                self.after_load();
+            }
+        }
+        Box::new(GLES2 {
+            desktop: self.desktop,
+            _gl_lifetime: PhantomData,
+        })
+    }
+
+    unsafe fn make_current_unchecked_for_window<'gl_ctx>(
+        &'gl_ctx mut self,
+        make_current_fn: &mut dyn FnMut(&GLContext),
+        loader_fn: &mut dyn FnMut(&'static str) -> *const std::ffi::c_void,
+    ) -> Box<dyn GLES + 'gl_ctx> {
+        if !(self.gl_ctx.is_current() && self.is_loaded) {
+            make_current_fn(&self.gl_ctx);
+            if !self.is_loaded {
+                // The loader wants 'static names; the bindings only pass
+                // string literals, so leaking the fallback names is bounded.
+                load(&mut |s| loader_fn(Box::leak(s.to_owned().into_boxed_str())));
+                self.is_loaded = true;
+                self.after_load();
+            }
+        }
+        Box::new(GLES2 {
+            desktop: self.desktop,
+            _gl_lifetime: PhantomData,
+        })
+    }
+}
+
+pub struct GLES2<'gl_ctx> {
+    desktop: bool,
+    _gl_lifetime: PhantomData<&'gl_ctx ()>,
+}
+
+/// Fixed-function state an ES 1.1 code path might query (fog workaround in
+/// glDrawArrays/glDrawElements): reported as off instead of a GL error.
+fn es1_only_pname(pname: GLenum) -> bool {
+    matches!(
+        pname,
+        gles11::FOG | gles11::FOG_START | gles11::FOG_END | gles11::FOG_DENSITY | gles11::FOG_MODE
+    )
+}
+
+#[allow(non_snake_case)]
+impl GLES for GLES2<'_> {
+    unsafe fn driver_description(&self) -> String {
+        let s = |name| {
+            let p = gles20::GetString(name);
+            if p.is_null() {
+                String::from("?")
+            } else {
+                CStr::from_ptr(p as *const _).to_string_lossy().into_owned()
+            }
+        };
+        format!(
+            "{} / {} / {}{}",
+            s(gles20::VERSION),
+            s(gles20::VENDOR),
+            s(gles20::RENDERER),
+            if self.desktop { " (OpenGL ES 2.0 on desktop OpenGL)" } else { "" }
+        )
+    }
+    unsafe fn GetBooleanv(&mut self, pname: GLenum, params: *mut GLboolean) {
+        if es1_only_pname(pname) {
+            *params = 0;
+            return;
+        }
+        gles20::GetBooleanv(pname, params)
+    }
+    unsafe fn GetFloatv(&mut self, pname: GLenum, params: *mut GLfloat) {
+        if es1_only_pname(pname) {
+            *params = 0.0;
+            return;
+        }
+        gles20::GetFloatv(pname, params)
+    }
+    unsafe fn GetIntegerv(&mut self, pname: GLenum, params: *mut GLint) {
+        if es1_only_pname(pname) {
+            *params = 0;
+            return;
+        }
+        gles20::GetIntegerv(pname, params)
+    }
+    unsafe fn TexImage2D(
+        &mut self,
+        target: GLenum,
+        level: GLint,
+        mut internalformat: GLint,
+        width: GLsizei,
+        height: GLsizei,
+        border: GLint,
+        format: GLenum,
+        type_: GLenum,
+        pixels: *const GLvoid,
+    ) {
+        if format == gles11::BGRA_EXT {
+            // iPhone OS (APPLE_texture_format_BGRA8888) takes RGBA as the
+            // internal format. EXT_texture_format_BGRA8888 (Android) wants
+            // BGRA in both; desktop OpenGL wants RGBA.
+            internalformat = if self.desktop {
+                gles11::RGBA as GLint
+            } else {
+                gles11::BGRA_EXT as GLint
+            };
+        } else if self.desktop && internalformat == gles11::BGRA_EXT as GLint {
+            internalformat = gles11::RGBA as GLint;
+        }
+        gles20::TexImage2D(
+            target,
+            level,
+            internalformat,
+            width,
+            height,
+            border,
+            format,
+            type_,
+            pixels,
+        )
+    }
+    unsafe fn CompressedTexImage2D(
+        &mut self,
+        target: GLenum,
+        level: GLint,
+        internalformat: GLenum,
+        width: GLsizei,
+        height: GLsizei,
+        border: GLint,
+        image_size: GLsizei,
+        data: *const GLvoid,
+    ) {
+        let bytes = std::slice::from_raw_parts(data.cast::<u8>(), image_size as usize);
+        // PVRTC exists only on PowerVR/Apple GPUs: decoded in software.
+        if try_decode_pvrtc(
+            self,
+            target,
+            level,
+            internalformat,
+            width,
+            height,
+            border,
+            bytes,
+        ) {
