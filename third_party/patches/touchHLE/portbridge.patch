+
+const kCFURLUnknownPropertyKeyError: i32 = -17;
+const kCFURLResourceNotFoundError: i32 = -12;
+
+/// PortBridge: `CFURLCreatePropertyFromResource` for file URLs. Supports
+/// `kCFURLFileExists` (CFBoolean) and `kCFURLFileLength` (CFNumber).
+fn CFURLCreatePropertyFromResource(
+    env: &mut Environment,
+    _allocator: CFAllocatorRef,
+    url: CFURLRef,
+    property: CFStringRef,
+    error_code: MutPtr<i32>,
+) -> id {
+    let set_err = |env: &mut Environment, code: i32| {
+        if !error_code.is_null() {
+            env.mem.write(error_code, code);
+        }
+    };
+    if url == nil || property == nil {
+        set_err(env, kCFURLUnknownPropertyKeyError);
+        return nil;
+    }
+    let key = to_rust_string(env, property).to_string();
+    let path = crate::frameworks::foundation::ns_url::to_rust_path(env, url).into_owned();
+    let result: id = match key.as_str() {
+        kCFURLFileExists => {
+            let exists = env.fs.exists(&path);
+            let n: id = msg_class![env; NSNumber numberWithBool:exists];
+            retain(env, n)
+        }
+        kCFURLFileLength => match env.fs.size(&path) {
+            Ok(size) => {
+                let n: id = msg_class![env; NSNumber numberWithLongLong:(size as i64)];
+                retain(env, n)
+            }
+            Err(()) => {
+                set_err(env, kCFURLResourceNotFoundError);
+                return nil;
+            }
+        },
+        _ => {
+            log!("TODO: CFURLCreatePropertyFromResource({:?}, {:?})", path, key);
+            set_err(env, kCFURLUnknownPropertyKeyError);
+            return nil;
+        }
+    };
+    set_err(env, 0);
+    log_dbg!("CFURLCreatePropertyFromResource({:?}, {}) => {:?}", path, key, result);
+    result
+}
