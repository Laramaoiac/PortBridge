+fn glVertexAttribPointer(
+    env: &mut Environment,
+    index: GLuint,
+    size: GLint,
+    type_: GLenum,
+    normalized: GLboolean,
+    stride: GLsizei,
+    pointer: ConstVoidPtr,
+) {
+    with_ctx2(env, "glVertexAttribPointer", |mem| unsafe {
+        // An offset into the bound GL_ARRAY_BUFFER, or a pointer into guest
+        // memory (client-side array), which is mapped contiguously in host
+        // memory and stays valid until the draw call.
+        let mut buffer: GLint = 0;
+        gl::GetIntegerv(gl::ARRAY_BUFFER_BINDING, &mut buffer);
+        let host: *const GLvoid = if buffer != 0 || pointer.is_null() {
+            pointer.to_bits() as usize as *const GLvoid
+        } else {
+            mem.unchecked_ptr_at(pointer.cast::<u8>(), 0).cast()
+        };
+        gl::VertexAttribPointer(index, size, type_, normalized, stride, host)
+    })
+}
+fn glGetVertexAttribPointerv(env: &mut Environment, index: GLuint, pname: GLenum, pointer: MutPtr<MutVoidPtr>) {
+    with_ctx2(env, "glGetVertexAttribPointerv", |mem| unsafe {
+        let mut host: *mut GLvoid = std::ptr::null_mut();
+        gl::GetVertexAttribPointerv(index, pname, &mut host);
+        let mut buffer: GLint = 0;
+        gl::GetVertexAttribiv(index, gl::VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &mut buffer);
+        let guest: MutVoidPtr = if buffer != 0 || host.is_null() {
+            Ptr::from_bits(host as usize as u32)
+        } else {
+            mem.host_ptr_to_guest_ptr(host as *const GLvoid).cast_mut()
+        };
+        mem.write(pointer, guest);
+    })
+}
