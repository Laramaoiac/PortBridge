+/// PortBridge: builds a `struct hostent` for one IPv4 address:
+/// `{ char *h_name; char **h_aliases; int h_addrtype; int h_length; char **h_addr_list; }`
+fn make_ipv4_hostent(env: &mut Environment, name: ConstPtr<u8>, ip: std::net::Ipv4Addr) -> MutPtr<hostent> {
+    let name_len = env.mem.cstr_at(name).len() as u32;
+    // hostent (20) + aliases [NULL] (4) + addr_list [ptr, NULL] (8) + addr (4) + name
+    let block: MutPtr<u8> = env.mem.alloc(20 + 4 + 8 + 4 + name_len + 1).cast();
+    let base = block.to_bits();
+    let aliases = base + 20;
+    let addr_list = aliases + 4;
+    let addr = addr_list + 8;
+    let name_copy = addr + 4;
+    let w32 = |env: &mut Environment, at: u32, v: u32| {
+        env.mem.write(MutPtr::<u32>::from_bits(at), v);
+    };
+    let name_bytes = env.mem.cstr_at(name).to_vec();
+    env.mem
+        .bytes_at_mut(MutPtr::from_bits(name_copy), name_len)
+        .copy_from_slice(&name_bytes);
+    env.mem.write(MutPtr::<u8>::from_bits(name_copy + name_len), 0u8);
+    env.mem
+        .bytes_at_mut(MutPtr::from_bits(addr), 4)
+        .copy_from_slice(&ip.octets());
+    w32(env, base, name_copy); // h_name
+    w32(env, base + 4, aliases); // h_aliases
+    w32(env, base + 8, AF_INET as u32); // h_addrtype
+    w32(env, base + 12, 4); // h_length
+    w32(env, base + 16, addr_list); // h_addr_list
+    w32(env, aliases, 0);
+    w32(env, addr_list, addr);
+    w32(env, addr_list + 4, 0);
+    log!("gethostbyname(\"{}\") => {} (IPv4 literal)", ip, ip);
+    block.cast()
+}
