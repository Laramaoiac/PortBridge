+                (mask & 2 != 0, f.size.width),
+                (mask & 4 != 0, right),
+            ],
+        );
+        // UIViewAutoresizingFlexible{TopMargin, Height, BottomMargin} = 8, 16, 32
+        let v = share(
+            dh,
+            [
+                (mask & 8 != 0, f.origin.y),
+                (mask & 16 != 0, f.size.height),
+                (mask & 32 != 0, bottom),
+            ],
+        );
+        f.origin.x += h[0];
+        f.size.width += h[1];
+        f.origin.y += v[0];
+        f.size.height += v[1];
