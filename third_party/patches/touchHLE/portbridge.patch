+//! PortBridge: the OpenGL ES 2.0 functions that OpenGL ES 1.1 doesn't have
+//! (shaders, programs, uniforms, vertex attributes, vertex array objects and
+//! the core names of the framebuffer functions).
+//!
+//! The functions both versions share live in [super::gles_guest] and reach the
+//! driver through [crate::gles::GLES], which [crate::gles::gles2] implements.
+
+use super::eagl::EAGLContextHostObject;
+use crate::dyld::{export_c_func, FunctionExports};
+use crate::gles::gles11_raw::types::{
+    GLboolean, GLchar, GLclampf, GLenum, GLfloat, GLint, GLsizei, GLuint, GLvoid,
+};
+use crate::gles::gles2::{raw as gl, shader_source_prefix};
+use crate::mem::{ConstPtr, ConstVoidPtr, GuestUSize, Mem, MutPtr, MutVoidPtr, Ptr};
+use crate::Environment;
+
+/// Makes the thread's EAGLContext current and runs `f` with the ES 2.0
+/// functions available. Without an ES 2.0 context the call is ignored (with a
+/// log line) and `f` is not run.
+fn with_ctx2<U: Default>(env: &mut Environment, name: &str, f: impl FnOnce(&mut Mem) -> U) -> U {
+    let Some(ctx) = *env
+        .framework_state
+        .opengles
+        .current_ctx_for_thread(env.current_thread)
+    else {
+        log!(
+            "Warning: {} called with no EAGLContext on thread {}; ignored",
+            name,
+            env.current_thread
+        );
+        return U::default();
+    };
+    if env.objc.borrow::<EAGLContextHostObject>(ctx).api != 2 {
+        log!("Warning: {} (OpenGL ES 2.0) called on an OpenGL ES 1.1 context; ignored", name);
+        return U::default();
+    }
+    let _gles = super::sync_context(
+        &mut env.framework_state.opengles,
+        &mut env.objc,
+        env.window
+            .as_mut()
+            .expect("OpenGL ES is not supported in headless mode"),
+        env.current_thread,
+    );
+    f(&mut env.mem)
+}
+
+fn count(n: GLsizei) -> GuestUSize {
+    n.max(0) as GuestUSize
+}
+
+/// Copies a host buffer into a guest `GLchar*` (`bufsize` bytes at most,
+/// NUL-terminated) and writes the length without the NUL to `length`.
+fn write_guest_string(mem: &mut Mem, s: &[u8], bufsize: GLsizei, length: MutPtr<GLsizei>, out: MutPtr<GLchar>) {
+    let n = if bufsize <= 0 || out.is_null() {
+        0
+    } else {
+        s.len().min(bufsize as usize - 1)
+    };
+    if !out.is_null() && bufsize > 0 {
+        let dst = mem.bytes_at_mut(out.cast(), n as GuestUSize + 1);
+        dst[..n].copy_from_slice(&s[..n]);
+        dst[n] = 0;
+    }
+    if !length.is_null() {
+        mem.write(length, n as GLsizei);
+    }
+}
+
+fn info_log(len: GLint, get: impl FnOnce(GLsizei, *mut GLsizei, *mut GLchar)) -> Vec<u8> {
+    let cap = len.max(1) as usize;
+    let mut buf = vec![0u8; cap];
+    let mut written: GLsizei = 0;
+    get(cap as GLsizei, &mut written, buf.as_mut_ptr() as *mut GLchar);
+    buf.truncate(written.max(0) as usize);
+    buf
+}
+
+// ---------------------------------------------------------------- shaders
+
+fn glCreateShader(env: &mut Environment, type_: GLenum) -> GLuint {
+    with_ctx2(env, "glCreateShader", |_| unsafe { gl::CreateShader(type_) })
+}
+fn glShaderSource(
+    env: &mut Environment,
+    shader: GLuint,
+    count_: GLsizei,
+    strings: ConstPtr<ConstPtr<GLchar>>,
+    lengths: ConstPtr<GLint>,
+) {
+    with_ctx2(env, "glShaderSource", |mem| {
+        let mut source = Vec::new();
+        for i in 0..count(count_) {
+            let s: ConstPtr<u8> = mem.read(strings + i).cast();
+            if s.is_null() {
+                continue;
+            }
+            let len = if lengths.is_null() { -1 } else { mem.read(lengths + i) };
+            if len < 0 {
+                source.extend_from_slice(mem.cstr_at(s));
+            } else {
+                source.extend_from_slice(mem.bytes_at(s, len as GuestUSize));
+            }
+        }
+        if let Some(prefix) = shader_source_prefix() {
+            if !source.windows(8).any(|w| w == b"#version") {
+                source.splice(0..0, prefix.bytes());
+            }
+        }
+        let ptr = source.as_ptr() as *const GLchar;
+        let len = source.len() as GLint;
+        unsafe { gl::ShaderSource(shader, 1, &ptr, &len) }
+    })
+}
+fn glCompileShader(env: &mut Environment, shader: GLuint) {
+    with_ctx2(env, "glCompileShader", |_| unsafe {
+        gl::CompileShader(shader);
+        let mut ok: GLint = 0;
+        gl::GetShaderiv(shader, gl::COMPILE_STATUS, &mut ok);
+        if ok == 0 {
+            let mut len: GLint = 0;
+            gl::GetShaderiv(shader, gl::INFO_LOG_LENGTH, &mut len);
+            let msg = info_log(len, |a, b, c| gl::GetShaderInfoLog(shader, a, b, c));
+            log!(
+                "PortBridge: shader {} failed to compile: {}",
+                shader,
+                String::from_utf8_lossy(&msg)
+            );
+        }
+    })
+}
+fn glGetShaderiv(env: &mut Environment, shader: GLuint, pname: GLenum, params: MutPtr<GLint>) {
+    with_ctx2(env, "glGetShaderiv", |mem| {
+        let mut v: GLint = 0;
+        unsafe { gl::GetShaderiv(shader, pname, &mut v) };
+        mem.write(params, v);
+    })
+}
+fn glGetShaderInfoLog(
+    env: &mut Environment,
+    shader: GLuint,
+    bufsize: GLsizei,
+    length: MutPtr<GLsizei>,
+    infolog: MutPtr<GLchar>,
+) {
+    with_ctx2(env, "glGetShaderInfoLog", |mem| {
+        let mut len: GLint = 0;
+        unsafe { gl::GetShaderiv(shader, gl::INFO_LOG_LENGTH, &mut len) };
+        let msg = info_log(len, |a, b, c| unsafe { gl::GetShaderInfoLog(shader, a, b, c) });
+        write_guest_string(mem, &msg, bufsize, length, infolog);
+    })
+}
+fn glGetShaderSource(
+    env: &mut Environment,
+    shader: GLuint,
+    bufsize: GLsizei,
+    length: MutPtr<GLsizei>,
+    source: MutPtr<GLchar>,
+) {
+    with_ctx2(env, "glGetShaderSource", |mem| {
+        let mut len: GLint = 0;
+        unsafe { gl::GetShaderiv(shader, gl::SHADER_SOURCE_LENGTH, &mut len) };
+        let mut src = info_log(len, |a, b, c| unsafe { gl::GetShaderSource(shader, a, b, c) });
+        if let Some(prefix) = shader_source_prefix() {
+            if src.starts_with(prefix.as_bytes()) {
+                src.drain(..prefix.len());
+            }
+        }
+        write_guest_string(mem, &src, bufsize, length, source);
+    })
+}
+fn glDeleteShader(env: &mut Environment, shader: GLuint) {
+    with_ctx2(env, "glDeleteShader", |_| unsafe { gl::DeleteShader(shader) })
+}
+fn glIsShader(env: &mut Environment, shader: GLuint) -> GLboolean {
+    with_ctx2(env, "glIsShader", |_| unsafe { gl::IsShader(shader) })
+}
+fn glReleaseShaderCompiler(_env: &mut Environment) {}
+fn glGetShaderPrecisionFormat(
+    env: &mut Environment,
+    _shadertype: GLenum,
+    precisiontype: GLenum,
+    range: MutPtr<GLint>,
+    precision: MutPtr<GLint>,
+) {
+    // What the iPhone's PowerVR SGX reports (desktop OpenGL may not have
+    // this function at all).
+    let (r, p) = match precisiontype {
+        gl::LOW_FLOAT | gl::MEDIUM_FLOAT | gl::HIGH_FLOAT => ((127, 127), 23),
+        _ => ((31, 30), 0),
+    };
+    with_ctx2(env, "glGetShaderPrecisionFormat", |mem| {
+        mem.write(range, r.0);
+        mem.write(range + 1, r.1);
+        mem.write(precision, p);
+    })
+}
+
+// ---------------------------------------------------------------- programs
+
+fn glCreateProgram(env: &mut Environment) -> GLuint {
+    with_ctx2(env, "glCreateProgram", |_| unsafe { gl::CreateProgram() })
