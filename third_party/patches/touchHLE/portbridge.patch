+        .audio_toolbox
+        .audio_file
+        .audio_files
+        .get(&host_object.guest_audio_file)
+        .unwrap()
+        .audio_file;
+    let desc = audio_file.audio_description();
+    (audio_file.packet_count() * u64::from(desc.frames_per_packet.max(1))) as i64
