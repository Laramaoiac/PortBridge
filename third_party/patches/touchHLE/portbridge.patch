+    let audio_file = &env
+        .framework_state
+        .audio_toolbox
+        .audio_file
+        .audio_files
+        .get(&host_object.guest_audio_file)
+        .unwrap()
+        .audio_file;
+    AudioStreamBasicDescription::from_audio_description(audio_file.audio_description())
