+//! `CFReadStream` for files (PortBridge).
+//!
+//! Only `CFReadStreamCreateWithFile` streams: the whole file is read when the
+//! stream is opened. Games of the iOS 3/4 era (e.g. ZENONIA 3) read their data
+//! packs this way.
+
+use super::cf_allocator::{kCFAllocatorDefault, CFAllocatorRef};
+use super::cf_url::CFURLRef;
+use super::{CFIndex, CFTypeRef};
+use crate::dyld::{export_c_func, FunctionExports};
+use crate::frameworks::foundation::ns_url::to_rust_path;
+use crate::fs::GuestPathBuf;
+use crate::mem::{GuestUSize, MutPtr};
+use crate::objc::{nil, objc_classes, ClassExports, HostObject};
+use crate::Environment;
+
+type CFReadStreamRef = CFTypeRef;
+
+pub const CLASSES: ClassExports = objc_classes! {
+
+(env, this, _cmd);
+
+@implementation _touchHLE_CFReadStream: NSObject
+@end
+
+};
+
+struct CFReadStreamHostObject {
+    path: GuestPathBuf,
+    data: Option<Vec<u8>>,
+    pos: usize,
+}
+impl HostObject for CFReadStreamHostObject {}
+
+fn CFReadStreamCreateWithFile(
+    env: &mut Environment,
+    allocator: CFAllocatorRef,
+    file_url: CFURLRef,
+) -> CFReadStreamRef {
+    assert!(allocator == kCFAllocatorDefault || env.mem.read(allocator).is_system_default()); // unimplemented
+    if file_url == nil {
+        return nil;
+    }
+    let path: GuestPathBuf = to_rust_path(env, file_url).into_owned();
+    log_dbg!("CFReadStreamCreateWithFile({:?})", path);
+    let host_obj = Box::new(CFReadStreamHostObject {
+        path,
+        data: None,
+        pos: 0,
+    });
+    let class = env.objc.get_known_class("_touchHLE_CFReadStream", &mut env.mem);
+    env.objc.alloc_object(class, host_obj, &mut env.mem)
+}
+
+fn CFReadStreamOpen(env: &mut Environment, stream: CFReadStreamRef) -> bool {
+    if stream == nil {
+        return false;
+    }
+    let path = env.objc.borrow::<CFReadStreamHostObject>(stream).path.clone();
+    log_dbg!("CFReadStreamOpen({:?}) {:?}", stream, path);
+    match env.fs.read(&path) {
+        Ok(bytes) => {
+            let host = env.objc.borrow_mut::<CFReadStreamHostObject>(stream);
+            host.data = Some(bytes);
+            host.pos = 0;
+            true
+        }
+        Err(()) => {
+            log!("CFReadStreamOpen: could not open {:?}", path);
+            false
+        }
+    }
+}
+
+fn CFReadStreamRead(
+    env: &mut Environment,
+    stream: CFReadStreamRef,
+    buffer: MutPtr<u8>,
+    buffer_length: CFIndex,
+) -> CFIndex {
+    if stream == nil || buffer_length < 0 {
+        return -1;
+    }
+    log_dbg!("CFReadStreamRead({:?}, {:?}, {})", stream, buffer, buffer_length);
+    let host = env.objc.borrow_mut::<CFReadStreamHostObject>(stream);
+    let Some(data) = host.data.as_ref() else {
+        return -1; // not open
+    };
+    let start = host.pos.min(data.len());
+    let n = (data.len() - start).min(buffer_length as usize);
+    let chunk = data[start..start + n].to_vec();
+    host.pos = start + n;
+    if n > 0 {
+        env.mem
+            .bytes_at_mut(buffer, n as GuestUSize)
+            .copy_from_slice(&chunk);
+    }
+    n as CFIndex
+}
+
+fn CFReadStreamHasBytesAvailable(env: &mut Environment, stream: CFReadStreamRef) -> bool {
+    if stream == nil {
+        return false;
+    }
+    let host = env.objc.borrow::<CFReadStreamHostObject>(stream);
+    host.data.as_ref().is_some_and(|d| host.pos < d.len())
+}
+
+fn CFReadStreamClose(env: &mut Environment, stream: CFReadStreamRef) {
+    if stream == nil {
+        return;
+    }
+    let host = env.objc.borrow_mut::<CFReadStreamHostObject>(stream);
+    host.data = None;
+    host.pos = 0;
+}
+
+pub const FUNCTIONS: FunctionExports = &[
+    export_c_func!(CFReadStreamCreateWithFile(_, _)),
+    export_c_func!(CFReadStreamOpen(_)),
+    export_c_func!(CFReadStreamRead(_, _, _)),
+    export_c_func!(CFReadStreamHasBytesAvailable(_)),
+    export_c_func!(CFReadStreamClose(_)),
+];
