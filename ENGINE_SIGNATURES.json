{
  "$schema": "https://portbridge.dev/schemas/engine-signatures.v1.json",
  "schema_version": "1.0.0",
  "coverage": {
    "ios_min": "1.0",
    "ios_max": "27.x",
    "description": "Catálogo mestre de assinaturas binárias, arquivos, símbolos Mach-O e regras de detecção para identificação forense de motores e frameworks em arquivos .ipa."
  },
  "macho_constants": {
    "magic": {
      "MH_MAGIC": "cefaedfe",
      "MH_CIGAM": "feedface",
      "MH_MAGIC_64": "cffaedfe",
      "MH_CIGAM_64": "feedfacf",
      "FAT_MAGIC": "cafebabe",
      "FAT_CIGAM": "bebafeca",
      "FAT_MAGIC_64": "cafebabf",
      "FAT_CIGAM_64": "bfbafeca"
    },
    "load_commands": {
      "LC_LOAD_DYLIB": "0x0000000c",
      "LC_LOAD_WEAK_DYLIB": "0x80000018",
      "LC_RPATH": "0x8000001c",
      "LC_ENCRYPTION_INFO": "0x00000021",
      "LC_ENCRYPTION_INFO_64": "0x0000002c",
      "LC_DYLD_INFO_ONLY": "0x80000022",
      "LC_DYLD_CHAINED_FIXUPS": "0x80000034",
      "LC_VERSION_MIN_IPHONEOS": "0x00000025",
      "LC_BUILD_VERSION": "0x00000032"
    },
    "fairplay_gate": {
      "abort_if_cryptid_nonzero": true,
      "sc_info_paths": [
        "SC_Info/*.sinf",
        "SC_Info/*.supp"
      ],
      "note": "Se cryptid != 0 em LC_ENCRYPTION_INFO(_64), o segmento __TEXT está cifrado por FairPlay DRM. O pipeline deve interromper extração de código/símbolos e alertar o usuário."
    }
  },
  "asset_format_signatures": [
    {
      "id": "png_cgbi",
      "name": "Apple CgBI Proprietary PNG",
      "magic_rules": [
        { "offset": 0, "hex": "89504e470d0a1a0a" },
        { "offset": 12, "hex": "43674249", "ascii": "CgBI" }
      ],
      "action": "transcode_cgbi_to_standard_rgba_png"
    },
    {
      "id": "png_standard",
      "name": "Standard PNG",
      "magic_rules": [
        { "offset": 0, "hex": "89504e470d0a1a0a" },
        { "offset": 12, "hex": "49484452", "ascii": "IHDR" }
      ],
      "action": "passthrough"
    },
    {
      "id": "assets_car",
      "name": "Apple CoreUI Asset Catalog (BOMStore)",
      "file_globs": ["**/Assets.car", "**/*.car"],
      "magic_rules": [
        { "offset": 0, "hex": "424f4d53746f7265", "ascii": "BOMStore" }
      ],
      "action": "unpack_coreui_car"
    },
    {
      "id": "bplist00",
      "name": "Apple Binary Property List",
      "file_globs": ["**/*.plist", "**/*.strings", "**/*.sks"],
      "magic_rules": [
        { "offset": 0, "hex": "62706c6973743030", "ascii": "bplist00" }
      ],
      "action": "decode_bplist"
    },
    {
      "id": "nib_archive",
      "name": "Compiled Interface Builder NIBArchive",
      "file_globs": ["**/*.nib", "**/*.storyboardc/**/*.nib"],
      "magic_rules": [
        { "offset": 0, "hex": "4e494241726368697665", "ascii": "NIBArchive" }
      ],
      "action": "inspect_nib_layout"
    },
    {
      "id": "metal_lib",
      "name": "Apple Compiled Metal Shader Library",
      "file_globs": ["**/*.metallib"],
      "magic_rules": [
        { "offset": 0, "hex": "4d544c42", "ascii": "MTLB" }
      ],
      "action": "map_or_decompile_metal_air"
    },
    {
      "id": "audio_caf",
      "name": "Apple Core Audio Format (CAF)",
      "file_globs": ["**/*.caf"],
      "magic_rules": [
        { "offset": 0, "hex": "63616666", "ascii": "caff" }
      ],
      "action": "transcode_caf_to_wav_or_ogg"
    },
    {
      "id": "texture_pvrtc_v3",
      "name": "PowerVR Texture v3 (PVRTC)",
      "file_globs": ["**/*.pvr"],
      "magic_rules": [
        { "offset": 0, "hex": "50565203" }
      ],
      "action": "decode_pvrtc_to_rgba_or_astc"
    },
    {
      "id": "texture_pvrtc_v2",
      "name": "PowerVR Texture v2 (Legacy)",
      "file_globs": ["**/*.pvr"],
      "magic_rules": [
        { "offset": 44, "hex": "50565221", "ascii": "PVR!" }
      ],
      "action": "decode_pvrtc_to_rgba_or_astc"
    },
    {
      "id": "texture_ccz",
      "name": "Cocos2d Compressed Texture (CCZ / CCZp)",
      "file_globs": ["**/*.pvr.ccz", "**/*.ccz"],
      "magic_rules_any": [
        { "offset": 0, "hex": "43435a21", "ascii": "CCZ!" },
        { "offset": 0, "hex": "43435a70", "ascii": "CCZp" }
      ],
      "action": "decompress_ccz_then_decode_pvr"
    },
    {
      "id": "texture_astc",
      "name": "ASTC Compressed Texture",
      "file_globs": ["**/*.astc"],
      "magic_rules": [
        { "offset": 0, "hex": "13aba15c" }
      ],
      "action": "passthrough_or_fallback_etc2"
    }
  ],
  "detection_rules": {
    "scoring_model": {
      "magic_match_weight": 60,
      "required_file_weight": 25,
      "framework_or_dylib_weight": 20,
      "macho_symbol_weight": 15,
      "minimum_confidence_threshold": 50
    },
    "evaluation_order": "Avaliar motores específicos de alta prioridade (priority menor primeiro) antes de fallbacks genéricos (ex.: Cordova/WebView antes de nativo puro; RPG Maker/Construct antes de Cordova genérico; Unity IL2CPP antes de Unity Mono)."
  },
