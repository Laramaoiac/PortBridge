@@ -0,0 +1,169 @@
+package com.abdurazaaqmohammed.utils;
+
+import com.reandroid.archive.ArchiveFile;
+import com.reandroid.archive.InputSource;
+
+import java.io.BufferedInputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/**
+ * Reads the entries of a split APK archive (APKS/XAPK/APKM/ZIP).
+ *
+ * ARSCLib's {@link ArchiveFile} locates the zip end record by scanning the last
+ * 64 KiB of the file. That fails ("Failed to find end record") for archives that
+ * are otherwise readable, most commonly when extra bytes were appended after the
+ * zip by the app that downloaded or shared it. In that case the archive is read
+ * again sequentially with {@link ZipInputStream}, which only needs the local file
+ * headers. Files that are not zips at all get an explicit error instead.
+ */
+public final class SplitArchiveReader {
+
+    public interface EntryHandler {
+        /** Called for every file entry; return normally to continue. */
+        void onEntry(String name, InputStream input) throws IOException;
+    }
+
+    /** Thrown when the selected file is empty or is not a zip archive. */
+    public static final class NotZipException extends IOException {
+        public NotZipException(String message) {
+            super(message);
+        }
+    }
+
+    private SplitArchiveReader() {
+    }
+
+    public static List<String> listApkNames(File archive) throws IOException {
+        final List<String> names = new ArrayList<>();
+        forEachEntry(archive, false, (name, input) -> {
+            if (name.endsWith(".apk"))
+                names.add(name);
+        });
+        return names;
+    }
+
+    /**
+     * Visits every file entry of the archive.
+     *
+     * @param openStreams when false, the handler receives {@code null} streams
+     *                    (used when only the names are needed).
+     */
+    public static void forEachEntry(File archive, boolean openStreams, EntryHandler handler)
+            throws IOException {
+        ArchiveFile archiveFile;
+        try {
+            archiveFile = new ArchiveFile(archive);
+        } catch (IOException e) {
+            if (!archive.isFile())
+                throw e;
+            // Explain empty / non-zip files instead of reporting the end record error.
+            try {
+                checkLooksLikeZip(archive);
+            } catch (NotZipException notZip) {
+                notZip.addSuppressed(e);
+                throw notZip;
+            }
+            // A real zip whose end record could not be found: read it front to back.
+            readSequentially(archive, openStreams, handler, e);
+            return;
+        }
+        try {
+            InputSource[] sources = archiveFile.getInputSources();
+            if (sources.length == 0) {
+                // A cut-off download can still expose a (bogus) end record with no
+                // usable central directory; the local headers may still be intact.
+                archiveFile.close();
+                readSequentially(archive, openStreams, handler,
+                        new IOException("The archive contains no entries; it may be incomplete"));
+                return;
+            }
+            for (InputSource entry : sources) {
+                if (!openStreams) {
+                    handler.onEntry(entry.getName(), null);
+                    continue;
+                }
+                try (InputStream input = entry.openStream()) {
+                    handler.onEntry(entry.getName(), input);
+                }
+            }
+        } finally {
+            archiveFile.close();
+        }
+    }
+
+    private static void readSequentially(File archive, boolean openStreams,
+            EntryHandler handler, IOException original) throws IOException {
+        int entries = 0;
+        try (ZipInputStream zip = new ZipInputStream(
+                new BufferedInputStream(new FileInputStream(archive), 64 * 1024))) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (entry.isDirectory())
+                    continue;
+                entries++;
+                handler.onEntry(entry.getName(), openStreams ? new NonClosingStream(zip) : null);
+                zip.closeEntry();
+            }
+        } catch (IOException e) {
+            if (entries == 0) {
+                original.addSuppressed(e);
+                throw original;
+            }
+            throw new IOException("The archive is incomplete (it ends inside entry "
+                    + entries + "). Download or copy the file again.", e);
+        }
+        if (entries == 0)
+            throw original;
+    }
+
+    /**
+     * Rejects files that cannot possibly be zips, with a message that says what
+     * was actually received instead of the low level "end record" error.
+     */
+    public static void checkLooksLikeZip(File file) throws IOException {
+        long length = file.length();
+        if (length == 0)
+            throw new NotZipException("The selected file is empty (0 bytes). "
+                    + "It may not have finished downloading, or the app it was opened from "
+                    + "did not share its contents.");
+        byte[] header = new byte[4];
+        int read;
+        try (InputStream input = new FileInputStream(file)) {
+            read = input.read(header);
+        }
+        // Local file header "PK\3\4", or an empty archive "PK\5\6".
+        if (read == 4 && header[0] == 'P' && header[1] == 'K'
+                && ((header[2] == 3 && header[3] == 4) || (header[2] == 5 && header[3] == 6)))
+            return;
+        throw new NotZipException(String.format(Locale.ROOT,
+                "The selected file is not a ZIP archive (size %d bytes, starts with %s). "
+                        + "Encrypted APKM files from APKMirror and other non-zip formats "
+                        + "cannot be merged.", length, hex(header, Math.max(read, 0))));
+    }
+
+    private static String hex(byte[] bytes, int count) {
+        StringBuilder builder = new StringBuilder();
+        for (int i = 0; i < count; i++)
+            builder.append(String.format(Locale.ROOT, "%02X", bytes[i] & 0xff));
+        return builder.length() == 0 ? "nothing" : builder.toString();
+    }
+
+    /** Lets a handler close its stream without closing the whole ZipInputStream. */
+    private static final class NonClosingStream extends java.io.FilterInputStream {
+        NonClosingStream(InputStream in) {
+            super(in);
+        }
+
+        @Override
+        public void close() {
+        }
+    }
+}
